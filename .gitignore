# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# next.js
frontend/.next/
# Scratch output for a verification build (NEXT_DIST_DIR), so checking that the
# production build still works cannot clobber a running dev server.
frontend/.next-verify/
frontend/out/
frontend/build/

# production
dist/
build/

# env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
# any hand-made backup/scratch copy of an env file (these carry live secrets)
.env.bak*
**/.env.bak*
.env.*.bak
**/.env.*.bak

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor / os
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
# Shared because it silences 14 phantom "Unknown at rule" problems from
# Tailwind's directives — an annoyance for anyone who opens this repo, not a
# personal preference.
!.vscode/settings.json
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.cache/

# database backups taken before migrations (contain real catalogue data)
backend/backups/

# port chosen by frontend/scripts/dev.js at runtime
